# OS cruft
Thumbs.db
desktop.ini
.DS_Store

# game data and what is extracted from it: never under version control
extracted/
*.bze
*.xa
*.obj
*.mtl
errors.txt

# local Python environment and caches
.venv/
__pycache__/
*.pyc

# a working copy's own game folder and its private export line
# (bblit/support/paths.py): never in the public copy
bblit/support/local_data.py
bblit/support/private_export.py

# settings of a portable copy (portable.flag)
userdata/
portable.flag

# the built executable (packaging/build_exe.py) and the release
# (packaging/make_release.py)
/BBLIT Viewer.exe
/_internal/
/_internal_old/
build/
release/

# what checks/run_checks.py writes: the reference photos (made from the
# game's data) and the logs
reference/
